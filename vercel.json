{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "{app,config,views,uploads}/**",
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "routes": [
    { "src": "/favicon\\.ico", "dest": "/assets/img/favicon2.svg" },
    { "src": "/(assets/.*)", "dest": "/$1" },
    { "src": "/(uploads/.*\\.(?:jpg|jpeg|png|webp|gif|svg))", "dest": "/$1" },
    { "src": "/index\\.php", "dest": "/api/index.php" },
    { "src": "/(.*)", "dest": "/api/index.php?p=$1" }
  ]
}
