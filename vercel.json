{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "{api,app,assets,config,views,uploads}/**",
      "maxDuration": 15
    }
  },
  "routes": [
    {
      "src": "/favicon\\.ico",
      "dest": "/assets/img/favicon2.svg"
    },
    {
      "src": "/index\\.php",
      "dest": "/api/index.php"
    },
    {
      "src": "/(?:config|app|views|database)(?:/.*)?",
      "status": 404
    },
    {
      "src": "/[^/]*\\.(?:php|sql|md|json|ya?ml|lock|ini|dist|sh|toml)$",
      "status": 404
    },
    {
      "src": "/Dockerfile$",
      "status": 404
    },
    {
      "src": "/(?:.*/)?\\.[^/]*",
      "status": 404
    },
    {
      "src": "/\\.[^/]*(?:/.*)?",
      "status": 404
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php?p=$1"
    }
  ]
}
