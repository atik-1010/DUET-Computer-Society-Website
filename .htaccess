# Optional pretty URLs. Requires Apache mod_rewrite.
# If you enable this, also set PRETTY_URLS to true in config/config.php
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?p=$1 [QSA,L]
</IfModule>

# Never serve raw uploads as executable code.
<FilesMatch "\.(php|phtml|phar)$">
    <If "%{REQUEST_URI} =~ m#^.*/uploads/#">
        Require all denied
    </If>
</FilesMatch>

Options -Indexes
